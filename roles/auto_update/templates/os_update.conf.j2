{#-
  Managed os-update configuration (/etc/os-update.conf, admin overrides only)
  derived from this role's parameters. Vendor defaults remain in
  /usr/share/os-update/os-update.conf.

  os-update only installs updates (no download-only/notify mode), has no
  per-package exclude and no built-in email; those parameters are intentionally
  not represented here (a notice is emitted from tasks/config/suse.yml).
-#}
# {{ ansible_managed }}
UPDATE_CMD="{{ 'security' if auto_update_linux_type == 'security' else 'auto' }}"
REBOOT_CMD="{{ 'auto' if auto_update_linux_reboot == 'when-needed' else 'none' }}"
{% set extra = auto_update_linux_extra_config['os-update'] | default({}) %}
{% for key, value in extra.items() %}
{{ key }}="{{ value }}"
{% endfor %}
