# {{ tpl_managed }}
#
# reboot-if-needed: reboot the system if (and only if) a reboot is required.
# auto-update-reboot.service passes --respect-timer-window. Operators can run
# the helper without arguments to request a needed reboot at any time.

set -u                                                      # no uninitialized variables
set -o 2>/dev/null | grep -Fq 'pipefail' && set +o pipefail # disable pipefail as it's non-POSIX

case "$#:${1-}" in
    0:|1:--respect-timer-window) ;;
    *)
        printf 'Usage: %s [--respect-timer-window]\n' "$0" >&2
        exit 2
        ;;
esac

__reboot_required='0'

# Debian-like reboot indicator file.
if [ "${__reboot_required}" != '1' ] &&
    [ -f '/var/run/reboot-required' ]; then
    __reboot_required='1'
fi

# openSUSE reboot indicator (zypper needs-rebooting), checked FIRST and
# authoritative wherever zypper exists. Only exit code 102
# (ZYPPER_EXIT_INF_REBOOT_NEEDED) means "reboot required"; any other
# non-zero code is an error and must NOT schedule a production reboot.
if [ "${__reboot_required}" != '1' ] &&
    command -v 'zypper' >/dev/null 2>&1; then
    zypper needs-rebooting >/dev/null 2>&1
    __zypper_rc="$?"
    if [ "${__zypper_rc}" = '102' ]; then
        __reboot_required='1'
    fi
    unset __zypper_rc
fi

# RedHat-like reboot indicator (needs-restarting -r).
# Only exit code 1 means "reboot required"; any other non-zero code is an error
# (e.g. a transient dnf/rpm failure) and must NOT schedule a production reboot.
# Skipped where zypper exists: SUSE ships needs-restarting as a wrapper that
# collapses EVERY non-zero "zypper needs-rebooting" exit - the reboot hint 102
# and real errors alike - into 1, which would turn a zypper error into a
# scheduled reboot.
if [ "${__reboot_required}" != '1' ] &&
    ! command -v 'zypper' >/dev/null 2>&1 &&
    command -v 'needs-restarting' >/dev/null 2>&1; then
    needs-restarting -r >/dev/null 2>&1
    __needs_restarting_rc="$?"
    if [ "${__needs_restarting_rc}" = '1' ]; then
        __reboot_required='1'
    fi
    unset __needs_restarting_rc
fi

# Running kernel differs from the newest installed kernel. The releases are
# compared EXACTLY (the filename prefix is stripped first): a substring test
# would accept a running "6.1.0-3" as the installed "6.1.0-30" and miss the
# required reboot. Rescue kernels and backup/boot-loader artifacts are not
# release candidates.
if [ "${__reboot_required}" != '1' ] &&
    [ -d '/boot' ]; then
    __kernel_installed="$(find /boot -maxdepth 1 -name 'vmlinuz-*' \
        ! -name 'vmlinuz-0-rescue-*' ! -name '*.old' \
        ! -name '*.efi' ! -name '*.img' -printf '%f\n' 2>/dev/null |
        sed -e 's/^vmlinuz-//' |
        sort -V |
        tail -n 1)"
    __kernel_current="$(uname -r)"
    if [ -n "${__kernel_installed}" ] &&
        [ "${__kernel_installed}" != "${__kernel_current}" ]; then
        __reboot_required='1'
    fi
    unset __kernel_installed __kernel_current
fi

# SELinux mode changed (requires a reboot to apply).
if [ "${__reboot_required}" != '1' ] &&
    command -v 'sestatus' >/dev/null 2>&1; then
    LC_ALL='C'
    export LC_ALL
    __selinux_current="$(sestatus 2>/dev/null | grep -i -E 'current.+mode' |
        cut -d':' -f2 | tr '[:upper:]' '[:lower:]' |
        sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    __selinux_config="$(sestatus 2>/dev/null | grep -i -E 'mode.+file' |
        cut -d':' -f2 | tr '[:upper:]' '[:lower:]' |
        sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    if [ -n "${__selinux_current}" ] &&
        [ -n "${__selinux_config}" ] &&
        [ "${__selinux_current}" != "${__selinux_config}" ]; then
        __reboot_required='1'
    fi
    unset __selinux_current __selinux_config
fi

[ "${__reboot_required}" = '1' ] || exit 0

if [ "$#" -eq 1 ]; then
    /usr/bin/python3 - <<'PYTHON'
import json
import os
import subprocess
import sys


def calendar_window_is_open(calendar, delay_us):
    # The first occurrence strictly after (now - delay) opens a window if it
    # has already elapsed. systemd compares microseconds even when displaying
    # wall-clock timestamps to whole seconds.
    output = subprocess.check_output(
        ["systemd-analyze", "calendar", f"--base-time=-{delay_us}us", "--", calendar],
        text=True,
    )
    fields = dict(line.strip().split(": ", 1) for line in output.splitlines() if ": " in line)
    if fields["Next elapse"] == "never":
        return False
    relative = fields["From now"]
    if relative == "now" or relative.endswith(" ago"):
        return True
    if relative.endswith(" left"):
        return False
    raise ValueError(f"Unexpected calendar result: {relative}")


def window_is_open():
    reply = subprocess.check_output(
        ["busctl", "--system", "--json=short", "call", "org.freedesktop.systemd1",
         "/org/freedesktop/systemd1/unit/auto_2dupdate_2dreboot_2etimer",
         "org.freedesktop.DBus.Properties", "GetAll", "s", "org.freedesktop.systemd1.Timer"],
        text=True,
    )
    timer = {key: value["data"] for key, value in json.loads(reply)["data"][0].items()}
    delay_us = timer["RandomizedDelayUSec"]
    calendars = timer["TimersCalendar"]
    # Monotonic triggers and clock changes can legitimately fire off calendar.
    if timer["TimersMonotonic"] or timer["OnClockChange"] or timer["OnTimezoneChange"]:
        return True
    if not calendars:
        raise ValueError("The reboot timer has no triggers")
    if timer["Persistent"] or timer.get("RandomizedOffsetUSec") or not delay_us:
        return True

    return any(calendar_window_is_open(calendar, delay_us) for _, calendar, _ in calendars)


os.environ.update(LC_ALL="C", SYSTEMD_COLORS="0")
os.environ.pop("TZ", None)  # Unqualified calendars use the system manager's timezone.
try:
    sys.exit(0 if window_is_open() else 3)
except (OSError, subprocess.SubprocessError, ValueError, KeyError, IndexError, TypeError) as error:
    sys.exit(f"Cannot verify the scheduled reboot window: {error}")
PYTHON
    case $? in
        0) ;;
        3)
            logger -t 'auto-update-reboot' 'Deferring required reboot outside the scheduled window.'
            exit 0
            ;;
        *) exit 1 ;;
    esac
fi

logger -t 'auto-update-reboot' 'Reboot required; scheduling reboot.' 2>/dev/null || true
exec shutdown -r +1 'Reboot required after automatic updates'
