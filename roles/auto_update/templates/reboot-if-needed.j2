#!/usr/bin/env sh
# {{ ansible_managed }}
#
# reboot-if-needed: reboot the system if (and only if) a reboot is required.
# Called by auto-update-reboot.service (triggered by auto-update-reboot.timer).

set -u                                                      # no uninitialized variables
set -o 2>/dev/null | grep -Fq 'pipefail' && set +o pipefail # disable pipefail as it's non-POSIX

__reboot_required='0'

# Debian-like reboot indicator file.
if [ "${__reboot_required}" != '1' ] &&
    [ -f '/var/run/reboot-required' ]; then
    __reboot_required='1'
fi

# RedHat-like reboot indicator (needs-restarting -r).
# Only exit code 1 means "reboot required"; any other non-zero code is an error
# (e.g. a transient dnf/rpm failure) and must NOT schedule a production reboot.
if [ "${__reboot_required}" != '1' ] &&
    command -v 'needs-restarting' >/dev/null 2>&1; then
    needs-restarting -r >/dev/null 2>&1
    __needs_restarting_rc="$?"
    if [ "${__needs_restarting_rc}" = '1' ]; then
        __reboot_required='1'
    fi
    unset __needs_restarting_rc
fi

# Running kernel differs from the newest installed kernel. The releases are
# compared EXACTLY (the filename prefix is stripped first): a substring test
# would accept a running "6.1.0-3" as the installed "6.1.0-30" and miss the
# required reboot. Rescue kernels and backup/boot-loader artifacts are not
# release candidates.
if [ "${__reboot_required}" != '1' ] &&
    [ -d '/boot' ]; then
    __kernel_installed="$(find /boot -maxdepth 1 -name 'vmlinuz-*' \
        ! -name 'vmlinuz-0-rescue-*' ! -name '*.old' \
        ! -name '*.efi' ! -name '*.img' -printf '%f\n' 2>/dev/null |
        sed -e 's/^vmlinuz-//' |
        sort -V |
        tail -n 1)"
    __kernel_current="$(uname -r)"
    if [ -n "${__kernel_installed}" ] &&
        [ "${__kernel_installed}" != "${__kernel_current}" ]; then
        __reboot_required='1'
    fi
    unset __kernel_installed __kernel_current
fi

# SELinux mode changed (requires a reboot to apply).
if [ "${__reboot_required}" != '1' ] &&
    command -v 'sestatus' >/dev/null 2>&1; then
    LC_ALL='C'
    export LC_ALL
    __selinux_current="$(sestatus 2>/dev/null | grep -i -E 'current.+mode' |
        cut -d':' -f2 | tr '[:upper:]' '[:lower:]' |
        sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    __selinux_config="$(sestatus 2>/dev/null | grep -i -E 'mode.+file' |
        cut -d':' -f2 | tr '[:upper:]' '[:lower:]' |
        sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    if [ -n "${__selinux_current}" ] &&
        [ -n "${__selinux_config}" ] &&
        [ "${__selinux_current}" != "${__selinux_config}" ]; then
        __reboot_required='1'
    fi
    unset __selinux_current __selinux_config
fi

if [ "${__reboot_required}" = '1' ]; then
    logger -t 'auto-update-reboot' 'Reboot required; scheduling reboot.' 2>/dev/null || true
    exec shutdown -r +1 'Reboot required after automatic updates'
fi

exit 0
