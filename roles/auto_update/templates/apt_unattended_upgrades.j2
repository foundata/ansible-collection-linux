{#-
  Managed unattended-upgrades configuration derived from this role's parameters.
  Loaded after the distribution default (50unattended-upgrades) due to the
  higher numeric prefix of the destination file.

  Note: apt list directives (e.g. Origins-Pattern, Package-Blacklist) are
  additive across apt.conf.d files. The security origins therefore extend the
  distribution default; the "-updates" origins are only added for type "all".

SPDX-FileCopyrightText: foundata GmbH <https://foundata.com>
SPDX-License-Identifier: GPL-3.0-or-later
-#}
# {{ tpl_managed }}

Unattended-Upgrade::Origins-Pattern {
{% for origin in tpl_apt_origins_security | ansible.builtin.default([]) %}
    "{{ origin }}";
{% endfor %}
{% if tpl_type == 'all' %}
{% for origin in tpl_apt_origins_all_extra | ansible.builtin.default([]) %}
    "{{ origin }}";
{% endfor %}
{% endif %}
};

{% if (tpl_exclude | ansible.builtin.length) > 0 %}
Unattended-Upgrade::Package-Blacklist {
{% for pkg in tpl_exclude %}
    "{{ pkg }}";
{% endfor %}
};
{% endif %}
Unattended-Upgrade::Download-Only "{{ 'true' if tpl_apply in ['download', 'notify'] else 'false' }}";
Unattended-Upgrade::Automatic-Reboot "{{ 'true' if tpl_reboot == 'immediate' else 'false' }}";
{% if (tpl_notify_email | ansible.builtin.length) > 0 %}
Unattended-Upgrade::Mail "{{ tpl_notify_email }}";
Unattended-Upgrade::MailReport "on-change";
{% endif %}
{% set _extra = tpl_extra_config['unattended-upgrades'] | ansible.builtin.default({}) %}
{% if (_extra | ansible.builtin.length) > 0 %}

// Additional options from auto_update_linux_extra_config['unattended-upgrades']
{% for key, value in _extra.items() %}
{{ key }} "{{ value }}";
{% endfor %}
{% endif %}
