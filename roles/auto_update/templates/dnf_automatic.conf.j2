{#-
  Managed dnf-automatic / dnf5 automatic configuration (/etc/dnf/automatic.conf)
  derived from this role's parameters.

  Section dictionaries are built from the dedicated parameters first, then the
  user's auto_update_linux_extra_config['dnf-automatic'] (keyed by section) is
  merged on top so it takes precedence.

SPDX-FileCopyrightText: foundata GmbH <https://foundata.com>
SPDX-License-Identifier: GPL-3.0-or-later
-#}
# {{ tpl_managed }}
{% set extra = tpl_extra_config['dnf-automatic'] | ansible.builtin.default({}) %}
{% set emit_via = 'email' if (tpl_notify_email | ansible.builtin.length) > 0
   else ('motd' if tpl_apply == 'notify' else 'stdio') %}
{% set sections = {
     'commands': {
       'upgrade_type': ('security' if tpl_type == 'security' else 'default'),
       'download_updates': ('yes' if tpl_apply in ['install', 'download'] else 'no'),
       'apply_updates': ('yes' if tpl_apply == 'install' else 'no'),
       'reboot': ('when-needed' if tpl_reboot == 'immediate' else 'never'),
     },
     'emitters': {
       'emit_via': emit_via,
     },
   } %}
{% if (tpl_exclude | ansible.builtin.length) > 0 %}
{%   set sections = sections | ansible.builtin.combine({'base': {'exclude': tpl_exclude | ansible.builtin.join(' ')}}) %}
{% endif %}
{% if (tpl_notify_email | ansible.builtin.length) > 0 %}
{%   set sections = sections | ansible.builtin.combine({'email': {'email_from': 'root', 'email_to': tpl_notify_email}}) %}
{% endif %}
{% set section_names = ((sections.keys() | ansible.builtin.list) + (extra.keys() | ansible.builtin.list)) | ansible.builtin.unique %}
{% for section in section_names %}
[{{ section }}]
{% set merged = (sections[section] | ansible.builtin.default({})) | ansible.builtin.combine(extra[section] | ansible.builtin.default({})) %}
{% for key, value in merged.items() %}
{{ key }} = {{ value }}
{% endfor %}

{% endfor %}
