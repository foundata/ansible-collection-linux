{#-
  Full systemd timer unit (not a drop-in) for the scheduled "reboot if needed"
  check. The [Timer] directives come from tpl_reboot_timer_settings (the merged
  effective settings). Boolean values are rendered as "true"/"false".
-#}
{%- set tpl_timer_trigger_directives = [
      'OnCalendar',
      'OnActiveSec',
      'OnBootSec',
      'OnStartupSec',
      'OnUnitActiveSec',
      'OnUnitInactiveSec',
    ]
-%}
# {{ ansible_managed }}
[Unit]
Description=Scheduled reboot-if-needed check
Documentation=https://foundata.com/en/projects/ansible-collection-linux/

[Timer]
{# Same value contract as the drop-in template: repeatable trigger directives
   accept a list and render one assignment per item, and an empty list drops
   the built-in default for that directive. No reset line is needed here, this
   is a role-owned unit without a vendor trigger to replace. #}
{% for key, value in (tpl_reboot_timer_settings | ansible.builtin.default({})).items() %}
{% if (key in tpl_timer_trigger_directives) and (value is ansible.builtin.iterable)
      and (value is not ansible.builtin.string) and (value is not ansible.builtin.mapping) %}
{% for tpl_timer_entry in value %}
{{ key }}={{ tpl_timer_entry }}
{% endfor %}
{% else %}
{{ key }}={{ value | ansible.builtin.ternary('true', 'false') if value is ansible.builtin.boolean else value }}
{% endif %}
{% endfor %}

[Install]
WantedBy=timers.target
