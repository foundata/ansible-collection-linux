{#-
  Render systemd timer [Timer] directives to a drop-in override file.

  Input variable: tpl_timer_settings (dict)

  Rules:
  - Always renders a "[Timer]" section header.
  - Keys are written as "Directive=Value".
  - If a value is boolean, it is rendered as "true" or "false".
  - All other value types are rendered as-is (stringified by Jinja).
  - All trigger directives (OnCalendar, OnActiveSec, OnBootSec, ...) feed ONE
    shared trigger list in systemd, and assigning the empty string to any single
    one of them resets that complete list, not just the directive it is assigned
    to. This file is a drop-in over a vendor timer that already ships its own
    trigger (e.g. apt-daily-upgrade.timer or dnf-automatic.timer at
    "*-*-* 6:00"), so exactly ONE reset line is emitted before the configured
    directives to drop the vendor trigger. Emitting a reset per directive would
    make every reset wipe the triggers rendered before it, so only the last
    configured trigger would survive. See systemd.timer(5) and systemd.unit(5):
    "assigning the empty string [...] resets the list".
-#}
{%- set tpl_timer_trigger_directives = [
      'OnCalendar',
      'OnActiveSec',
      'OnBootSec',
      'OnStartupSec',
      'OnUnitActiveSec',
      'OnUnitInactiveSec',
    ]
-%}
{#- Only reset when a trigger is actually configured. The role's internal
    defaults always carry an OnCalendar, so with the public settings mapping
    this branch is currently always taken; the guard keeps the template correct
    if it is ever rendered with a mapping that configures no trigger at all. -#}
{%- set tpl_timer_ns = namespace(has_trigger=false) -%}
{%- for key in (tpl_timer_settings | default({})).keys() -%}
{%-   if key in tpl_timer_trigger_directives -%}
{%-     set tpl_timer_ns.has_trigger = true -%}
{%-   endif -%}
{%- endfor -%}
# {{ ansible_managed }}
[Timer]
{% if tpl_timer_ns.has_trigger %}
OnCalendar=
{% endif %}
{#- Repeatable trigger directives accept a list: one assignment per item, all
    of them after the single shared reset above. Every other value is rendered
    as a single assignment. Unsupported combinations (a list for a
    non-repeatable directive, an empty list, a boolean or mapping for a trigger)
    are rejected in the role's init tasks rather than silently mis-rendered. -#}
{% for key, value in (tpl_timer_settings | default({})).items() %}
{% if (key in tpl_timer_trigger_directives) and (value is ansible.builtin.iterable)
      and (value is not ansible.builtin.string) and (value is not ansible.builtin.mapping) %}
{% for tpl_timer_entry in value %}
{{ key }}={{ tpl_timer_entry }}
{% endfor %}
{% else %}
{{ key }}={{ value | ternary('true', 'false') if value is ansible.builtin.boolean else value }}
{% endif %}
{% endfor %}
