{#-
  Managed unattended-upgrades configuration derived from this role's parameters.
  Loaded after the distribution default (50unattended-upgrades) due to the
  higher numeric prefix of the destination file.

  Note: apt list directives (e.g. Origins-Pattern, Package-Blacklist) are
  additive across apt.conf.d files. The security origins therefore extend the
  distribution default; the "-updates" origins are only added for type "all".
-#}
# {{ ansible_managed }}

Unattended-Upgrade::Origins-Pattern {
{% for origin in __auto_update_linux_apt_origins_security | ansible.builtin.default([]) %}
    "{{ origin }}";
{% endfor %}
{% if auto_update_linux_type == 'all' %}
{% for origin in __auto_update_linux_apt_origins_all_extra | ansible.builtin.default([]) %}
    "{{ origin }}";
{% endfor %}
{% endif %}
};

{% if (auto_update_linux_exclude | ansible.builtin.length) > 0 %}
Unattended-Upgrade::Package-Blacklist {
{% for pkg in auto_update_linux_exclude %}
    "{{ pkg }}";
{% endfor %}
};
{% endif %}
Unattended-Upgrade::Download-Only "{{ 'true' if auto_update_linux_apply in ['download', 'notify'] else 'false' }}";
Unattended-Upgrade::Automatic-Reboot "{{ 'true' if auto_update_linux_reboot == 'immediate' else 'false' }}";
{% if (auto_update_linux_notify_email | ansible.builtin.length) > 0 %}
Unattended-Upgrade::Mail "{{ auto_update_linux_notify_email }}";
Unattended-Upgrade::MailReport "on-change";
{% endif %}
{% set _extra = auto_update_linux_extra_config['unattended-upgrades'] | ansible.builtin.default({}) %}
{% if (_extra | ansible.builtin.length) > 0 %}

// Additional options from auto_update_linux_extra_config['unattended-upgrades']
{% for key, value in _extra.items() %}
{{ key }} "{{ value }}";
{% endfor %}
{% endif %}
